    ShardingSpecProto -> ShardedDimProto [label="sharded_dim"];
    ShardedDimProto -> SimpleShardedDimProto [label="simple_sharding"];

    ValueInfoProto -> TypeProto [label="type"];
    ValueInfoProto -> StringStringEntryProto [label="metadata_props"];

    TensorShapeProto -> Dimension [label="dim"];

    TypeProto -> "TypeProto.Tensor" [label="tensor_type"];
    TypeProto -> "TypeProto.SparseTensor" [label="sparse_tensor_type"];
    TypeProto -> "TypeProto.Sequence" [label="sequence_type"];
    TypeProto -> "TypeProto.Map" [label="map_type"];
    TypeProto -> "TypeProto.Optional" [label="optional_type"];
    TypeProto -> "TypeProto.Opaque" [label="opaque_type"];
    TypeProto -> StructTypeProto [label="struct_type"];
    "TypeProto.Tensor" -> TensorShapeProto [label="shape"];
    "TypeProto.SparseTensor" -> TensorShapeProto [label="shape"];
    "TypeProto.Sequence" -> TypeProto [label="elem_type"];
    "TypeProto.Optional" -> TypeProto [label="elem_type"];
    "TypeProto.Map" -> TypeProto [label="value_type"];

    TensorProto -> Segment [label="segment"];
    TensorProto -> StringStringEntryProto [label="external_data, metadata_props"];

    SparseTensorProto -> TensorProto [label="values, indices"];

    AttributeProto -> TensorProto [label="t, tensors"];
    AttributeProto -> GraphProto [label="g, graphs"];
    AttributeProto -> SparseTensorProto [label="sparse_tensor, sparse_tensors"];
    AttributeProto -> TypeProto [label="tp, type_protos"];

    TensorAnnotation -> StringStringEntryProto [label="quant_parameter_tensor_names"];

    SequenceProto -> TensorProto [label="tensor_values"];
    SequenceProto -> SparseTensorProto [label="sparse_tensor_values"];
    SequenceProto -> SequenceProto [label="sequence_values"];
    SequenceProto -> MapProto [label="map_values"];
