dump_test/
temp_*
plot*.png
gmon.out
callgrind.out*

# scikit-build CMake build files
_skbuild/

# CMake build artifacts
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.o

# Test-generated ONNX model artifacts
*.onnx
*.data
