digraph library_split {
    rankdir=TB;
    nodesep=0.5;
    ranksep=0.7;
    node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", fontname="Helvetica", fontsize=12, color="#1F618D"];
    edge [fontname="Helvetica", fontsize=10, color="#566573"];

    lib_onnx_core -> lib_onnx_proto;
    lib_onnx_op -> lib_onnx_core;
    lib_onnx_shape -> lib_onnx_core;
    lib_onnx_patterns -> lib_onnx_core;
    lib_onnx_manipulations -> lib_onnx_core;
    lib_onnx_kernels -> lib_onnx_core;
    lib_onnx_gradient -> lib_onnx_core;
    lib_onnx_lib -> lib_onnx_manipulations;
    lib_onnx_backend_test -> lib_onnx_kernels;
}
