@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@OpenSSL_FOUND@)
  find_dependency(OpenSSL COMPONENTS Crypto)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/onnx_protoTargets.cmake")

# Preserve the target used by existing onnx-light C++ consumers.
if(NOT TARGET onnx_light::lib_onnx_proto)
  add_library(onnx_light::lib_onnx_proto INTERFACE IMPORTED)
  set_target_properties(onnx_light::lib_onnx_proto PROPERTIES
      INTERFACE_LINK_LIBRARIES onnx_proto::lib_onnx_proto)
endif()

check_required_components(onnx_proto)
