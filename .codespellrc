[codespell]
# Keep "implementors" in upstream ONNX schema docstrings for exact API parity.
# "suh" is an upstream EXL3 checkpoint tensor name.
ignore-words-list = afe,numer,vas,clens,paeth,abd,cann,statics,implementors,suh
ignore-regex = (?<![A-Za-z'])[A-Za-z]{1,2}(?![A-Za-z'])
skip = .git,docs/build,*/compound.xsd,*.svg
