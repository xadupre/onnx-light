# Doxyfile for onnx-light C++ API documentation
# Used by breathe to integrate C++ docs into the Sphinx documentation.

PROJECT_NAME           = "onnx-light"
PROJECT_BRIEF          = "ONNX without protobuf"
OUTPUT_DIRECTORY       = $(DOXYGEN_OUTPUT_DIR)
INPUT                  = ../onnx_light/cpp/include \
                         ../onnx_light/onnx
FILE_PATTERNS          = *.h *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */_onnxpy.cpp \
                         */onnx.cpp \
                         */onnx_helper.cpp \
                         */simple_string.cpp \
                         */stream.cpp \
                         */thread_pool.cpp \
                         */onnx_light_helpers.cpp \
                         */stream_class_print.hpp \
                         */stream_class_read.hpp \
                         */stream_class_size.hpp \
                         */stream_class_write.hpp \
                         */stream_class.hpp \
                         */fields.hpp \
                         */common/simple_span.h \
                         */defs/operator_sets*.h \
                         */common/schema.h

# Output formats: XML is required for Breathe; disable HTML (Sphinx handles it)
GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES

# Expand the code-generation macros from stream_class.h so that Doxygen sees
# the full class hierarchy defined in onnx.h.
#
# BEGIN_PROTO / BEGIN_PROTO_NOINIT open a class with the embedded doc-string.
# END_PROTO closes the class.
# FIELD* macros each expand to a documented member declaration.
# SERIALIZATION_METHOD expands to the parse/serialize method signatures.
PREDEFINED             = \
    "ONNX_API=" \
    "ONNX_OPERATOR_SET_SCHEMA_CLASS_NAME(domain,ver,name)=name" \
    "BEGIN_PROTO(cls,doc)=/** doc */ class cls : public onnx::Message { public:" \
    "BEGIN_PROTO_NOINIT(cls,doc)=/** doc */ class cls : public onnx::Message { public:" \
    "END_PROTO()=};" \
    "FIELD(type,name,order,doc)=/** doc */ type name;" \
    "FIELD_DEFAULT(type,name,order,default_value,doc)=/** doc */ type name;" \
    "FIELD_STR(name,order,doc)=/** doc */ onnx::utils::String name;" \
    "FIELD_REPEATED(type,name,order,doc)=/** doc */ onnx::utils::RepeatedField<type> name;" \
    "FIELD_REPEATED_PROTO(type,name,order,doc)=/** doc */ onnx::utils::RepeatedProtoField<type> name;" \
    "FIELD_REPEATED_PACKED(type,name,order,doc)=/** doc */ onnx::utils::RepeatedField<type> name;" \
    "FIELD_OPTIONAL(type,name,order,doc)=/** doc */ onnx::utils::OptionalField<type> name;" \
    "FIELD_OPTIONAL_ONEOF(type,name,order,oneof,doc)=/** doc */ onnx::utils::OptionalField<type> name;" \
    "FIELD_OPTIONAL_ENUM(type,name,order,doc)=/** doc */ onnx::utils::OptionalEnumField<type> name;" \
    "SERIALIZATION_METHOD()=uint64_t SerializeSize() const; void ParseFromString(const std::string &raw); void ParseFromString(const std::string &raw, onnx::ParseOptions &options); void SerializeToString(std::string &out) const; void SerializeToString(std::string &out, onnx::SerializeOptions &options) const; uint64_t SerializeSize(onnx::utils::BinaryWriteStream &stream, onnx::SerializeOptions &options) const; void ParseFromStream(onnx::utils::BinaryStream &stream, onnx::ParseOptions &options); void SerializeToStream(onnx::utils::BinaryWriteStream &stream, onnx::SerializeOptions &options) const; std::vector<std::string> PrintToVectorString(onnx::utils::PrintOptions &options) const;" \
    "define_data(type, field)=/** doc */  template <> inline type *Tensor::data<type>() { if (is_raw_data_) { return reinterpret_cast<type *>(raw_data_.data()); } return field.data
    (); } template <> inline const type *Tensor::data<type>() const {  if (is_raw_data_) { return reinterpret_cast<const type *>(raw_data_.data()); } return field.data(); }"

# Quiet mode
QUIET                  = YES
WARNINGS               = YES
