      <memberdef kind="function" id="namespaceONNX__LIGHT__NAMESPACE_1_1onnx__optim_1_1shapes_1af564e8741c6e6fdca625c92b03c30255" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
