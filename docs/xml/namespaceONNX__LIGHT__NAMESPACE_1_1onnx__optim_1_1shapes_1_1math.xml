        <argsstring>(ShapesContext &amp;ctx, const NodeProto &amp;node, const char *x)</argsstring>
        <name>ComputeShapeAbs</name>
        <qualifiedname>ONNX_LIGHT_NAMESPACE::onnx_optim::shapes::math::ComputeShapeAbs</qualifiedname>
