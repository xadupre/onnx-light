      <memberdef kind="variable" id="structONNX__LIGHT__NAMESPACE_1_1ParseOptions_1a25f300cefc15638998f96c8140d4393e" prot="public" static="no" mutable="no">
        <type>int32_t</type>
        <definition>int32_t ONNX_LIGHT_NAMESPACE::ParseOptions::num_threads</definition>
        <argsstring></argsstring>
        <name>num_threads</name>
        <qualifiedname>ONNX_LIGHT_NAMESPACE::ParseOptions::num_threads</qualifiedname>
        <initializer>= 1</initializer>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Number of threads to use for parallel reading of big blocks.<itemizedlist>
<listitem><para><computeroutput>1</computeroutput> (default): no parallelization, everything runs on the calling thread.</para>
</listitem><listitem><para><computeroutput>&gt; 1</computeroutput>: use exactly this many worker threads.</para>
</listitem><listitem><para><computeroutput>&lt; 0</computeroutput>: choose a sensible value based on the number of available CPU cores (<computeroutput>std::thread::hardware_concurrency()</computeroutput>).</para>
</listitem><listitem><para><computeroutput>0</computeroutput>: treated the same as <computeroutput>1</computeroutput> (no parallelization) for the purposes of :cpp:func:<computeroutput>is_parallel</computeroutput>. </para>
</listitem></itemizedlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
