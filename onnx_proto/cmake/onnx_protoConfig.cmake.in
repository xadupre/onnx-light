@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(onnx_threads CONFIG
    HINTS "${CMAKE_CURRENT_LIST_DIR}/../onnx_threads")
if(@OpenSSL_FOUND@)
  find_dependency(OpenSSL COMPONENTS Crypto)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/onnx_protoTargets.cmake")

check_required_components(onnx_proto)
