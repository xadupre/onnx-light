      <memberdef kind="function" id="namespaceONNX__LIGHT__NAMESPACE_1_1onnx__optim_1_1shapes_1aa7423f4e2068d65abf520501f69bf5c4" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
