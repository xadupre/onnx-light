digraph protos {
    rankdir=LR;
    nodesep=0.6;
    ranksep=0.1;
    node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", fontname="Helvetica", fontsize=12, color="#1F618D"];
    edge [fontname="Helvetica", fontsize=10, color="#566573"];

    subgraph cluster_container {
        label="Container";
        color="#1F618D";
        style=rounded;
        PipelineProto;
        ModelProto;
        GraphProto;
        FunctionProto;
        NodeProto;
        AttributeProto;
        NodeDeviceConfigurationProto;
        ShardingSpecProto;
        ShardedDimProto;
        PagedCacheProto;
        PagedCacheBlockProto;
        SequenceProto;
        MapProto;
        OptionalProto;
        RewritingProto;
        LocalRewritingProto;
    }

    subgraph cluster_data {
        label="Data";
        color="#239B56";
        style=rounded;
        node [fillcolor="#E9F7EF", color="#239B56"];
        TensorProto;
        SparseTensorProto;
        StringStringEntryProto;
        Segment;
        OperatorSetIdProto;
        DeviceConfigurationProto;
        IntIntListEntryProto;
        SimpleShardedDimProto;
        PersistentBindingProto;
        ExtendedInitializerProto;

        subgraph cluster_quantization {
            label="Quantization";
            color="#CA6F1E";
            style=rounded;
            node [fillcolor="#FEF5E7", color="#CA6F1E"];
            TensorAnnotation;
            EncodedValueProto;
            AffineLayoutProto;
        }
    }

    subgraph cluster_types {
        label="Struct and Types";
        color="#7D3C98";
        style=rounded;
        node [fillcolor="#F4ECF7", color="#7D3C98"];
        ValueInfoProto;
        TypeProto;
        "TypeProto.Tensor";
        "TypeProto.SparseTensor";
        "TypeProto.Sequence";
        "TypeProto.Map";
        "TypeProto.Optional";
        "TypeProto.Opaque";
        TensorShapeProto;
        Dimension;
        StructTypeProto;
        "StructTypeProto.Array";
        "StructTypeProto.Structure";
        "StructTypeProto.Structure.Field";
        "StructTypeProto.BitPacking";
        "StructTypeProto.BitPacking.Component";
    }

    PipelineProto -> ModelProto [label="embedding, prefill, decode"];
    PipelineProto -> StringStringEntryProto [label="metadata_props"];

    ModelProto -> GraphProto [label="graph"];
    ModelProto -> OperatorSetIdProto [label="opset_import"];
    ModelProto -> FunctionProto [label="functions"];
    ModelProto -> DeviceConfigurationProto [label="configuration"];
    ModelProto -> StringStringEntryProto [label="metadata_props"];
    ModelProto -> StructTypeProto [label="struct_types"];
    ModelProto -> RewritingProto [label="rewritings"];

    RewritingProto -> LocalRewritingProto [label="rewrites"];
    RewritingProto -> OperatorSetIdProto [label="required_opset_imports"];
    RewritingProto -> FunctionProto [label="added_functions"];
    RewritingProto -> StringStringEntryProto [label="metadata_props"];
    LocalRewritingProto -> NodeProto [label="added_nodes, initializer_calls"];
    LocalRewritingProto -> TensorProto [label="added_initializers"];
    LocalRewritingProto -> StringStringEntryProto [label="metadata_props"];

    GraphProto -> NodeProto [label="node"];
    GraphProto -> TensorProto [label="initializer"];
    GraphProto -> SparseTensorProto [label="sparse_initializer"];
    GraphProto -> ValueInfoProto [label="input, output, value_info"];
    GraphProto -> TensorAnnotation [label="quantization_annotation"];
    GraphProto -> StringStringEntryProto [label="metadata_props"];
    GraphProto -> ExtendedInitializerProto [label="extended_initializer"];
    ExtendedInitializerProto -> EncodedValueProto [label="encoded_value"];
    ExtendedInitializerProto -> PagedCacheProto [label="paged_cache"];
    GraphProto -> PersistentBindingProto [label="persistent_bindings"];

    PagedCacheProto -> PagedCacheBlockProto [label="blocks"];
    PagedCacheBlockProto -> TensorProto [label="key, value"];
    PagedCacheBlockProto -> EncodedValueProto [label="encoded_key, encoded_value"];
    PersistentBindingProto -> ValueInfoProto [label="input_name, output_name (graph IO)", style=dashed];

    EncodedValueProto -> AffineLayoutProto [label="affine"];
    EncodedValueProto -> StructTypeProto [label="struct_type"];
    EncodedValueProto -> TypeProto [label="logical_type"];
    EncodedValueProto -> StringStringEntryProto [label="external_data"];
    EncodedValueProto -> TensorAnnotation [label="parameter_ref (model catalogue)", style=dashed];
    AffineLayoutProto -> TensorProto [label="scale, zero_point"];

    StructTypeProto -> "StructTypeProto.Array" [label="array"];
    StructTypeProto -> "StructTypeProto.Structure" [label="structure"];
    StructTypeProto -> "StructTypeProto.BitPacking" [label="bit_packing"];
    StructTypeProto -> FunctionProto [label="decoder, encoder"];
    StructTypeProto -> StringStringEntryProto [label="metadata_props"];
    StructTypeProto -> StructTypeProto [label="type_ref (model catalogue ID)", style=dashed];
    "StructTypeProto.Array" -> TypeProto [label="element_type"];
    "StructTypeProto.Structure" -> "StructTypeProto.Structure.Field" [label="field"];
    "StructTypeProto.Structure.Field" -> TypeProto [label="type"];
    "StructTypeProto.Structure.Field" -> TensorProto [label="constant"];
    "StructTypeProto.BitPacking" -> "StructTypeProto.BitPacking.Component" [label="component"];

    FunctionProto -> AttributeProto [label="attribute_proto"];
    FunctionProto -> NodeProto [label="node"];
    FunctionProto -> OperatorSetIdProto [label="opset_import"];
    FunctionProto -> ValueInfoProto [label="value_info"];
    FunctionProto -> StringStringEntryProto [label="metadata_props"];

    NodeProto -> AttributeProto [label="attribute"];
    NodeProto -> NodeDeviceConfigurationProto [label="device_configurations"];
    NodeProto -> StringStringEntryProto [label="metadata_props"];

    NodeDeviceConfigurationProto -> ShardingSpecProto [label="sharding_spec"];
    NodeDeviceConfigurationProto -> DeviceConfigurationProto [label="configuration_id", style=dashed];
    ShardingSpecProto -> IntIntListEntryProto [label="index_to_device_group_map"];
    ShardingSpecProto -> ShardedDimProto [label="sharded_dim"];
    ShardedDimProto -> SimpleShardedDimProto [label="simple_sharding"];

    ValueInfoProto -> TypeProto [label="type"];
    ValueInfoProto -> StringStringEntryProto [label="metadata_props"];

    TensorShapeProto -> Dimension [label="dim"];

    TypeProto -> "TypeProto.Tensor" [label="tensor_type"];
    TypeProto -> "TypeProto.SparseTensor" [label="sparse_tensor_type"];
    TypeProto -> "TypeProto.Sequence" [label="sequence_type"];
    TypeProto -> "TypeProto.Map" [label="map_type"];
    TypeProto -> "TypeProto.Optional" [label="optional_type"];
    TypeProto -> "TypeProto.Opaque" [label="opaque_type"];
    TypeProto -> StructTypeProto [label="struct_type"];
    "TypeProto.Tensor" -> TensorShapeProto [label="shape"];
    "TypeProto.SparseTensor" -> TensorShapeProto [label="shape"];
    "TypeProto.Sequence" -> TypeProto [label="elem_type"];
    "TypeProto.Optional" -> TypeProto [label="elem_type"];
    "TypeProto.Map" -> TypeProto [label="value_type"];

    TensorProto -> Segment [label="segment"];
    TensorProto -> StringStringEntryProto [label="external_data, metadata_props"];

    SparseTensorProto -> TensorProto [label="values, indices"];

    AttributeProto -> TensorProto [label="t, tensors"];
    AttributeProto -> GraphProto [label="g, graphs"];
    AttributeProto -> SparseTensorProto [label="sparse_tensor, sparse_tensors"];
    AttributeProto -> TypeProto [label="tp, type_protos"];

    TensorAnnotation -> StringStringEntryProto [label="quant_parameter_tensor_names"];

    SequenceProto -> TensorProto [label="tensor_values"];
    SequenceProto -> SparseTensorProto [label="sparse_tensor_values"];
    SequenceProto -> SequenceProto [label="sequence_values"];
    SequenceProto -> MapProto [label="map_values"];
    SequenceProto -> OptionalProto [label="optional_values"];

    MapProto -> SequenceProto [label="values"];

    OptionalProto -> TensorProto [label="tensor_value"];
    OptionalProto -> SparseTensorProto [label="sparse_tensor_value"];
    OptionalProto -> SequenceProto [label="sequence_value"];
    OptionalProto -> MapProto [label="map_value"];
    OptionalProto -> OptionalProto [label="optional_value"];
}
